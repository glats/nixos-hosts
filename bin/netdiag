#!/usr/bin/env bash
# netdiag — Network diagnostic snapshot for multi-NIC Realtek hosts.
#
# Run WHEN you feel slowness. Captures everything needed to diagnose
# the r8169 / multi-homed issues on the T14.
#
# Usage: netdiag              # full snapshot
#        netdiag --watch 5    # monitor every 5s, print only on degradation

set -euo pipefail

WATCH_INTERVAL="${1:-0}"
if [ "$WATCH_INTERVAL" = "--watch" ]; then
  WATCH_INTERVAL="${2:-5}"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

header() { printf "\n${YELLOW}=== %s ===${NC}\n" "$1"; }
metric_ok() { printf "  ${GREEN}✔${NC} %-35s %s\n" "$1" "$2"; }
metric_warn() { printf "  ${RED}✘${NC} %-35s %s\n" "$1" "$2"; }

needs_sudo() {
  if [ "$(id -u)" -eq 0 ]; then return 0; fi
  if sudo -n true 2>/dev/null; then return 0; fi
  return 1
}

capture_snapshot() {
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"

  echo ""
  echo "══════════════════════════════════════════════"
  echo "  NETWORK DIAGNOSTIC — $ts"
  echo "══════════════════════════════════════════════"

  # ── ROUTING ──────────────────────────────────
  header "ROUTING TABLE"
  ip route show | grep -E 'default|172\.' | while read -r line; do
    metric_ok "route" "$line"
  done

  # ── INTERFACE STATUS ─────────────────────────
  header "INTERFACE STATUS"
  for iface in /sys/class/net/enp*; do
    [ -d "$iface" ] || continue
    local name
    name="$(basename "$iface")"
    local operstate speed mtu
    operstate="$(cat "$iface/operstate" 2>/dev/null || echo unknown)"
    speed="$(cat "$iface/speed" 2>/dev/null || echo N/A)"
    mtu="$(cat "$iface/mtu" 2>/dev/null || echo N/A)"
    printf "  %s: state=%-5s speed=%-4s mtu=%-5s\n" \
      "$name" "$operstate" "${speed}Mb/s" "$mtu"
  done

  # ── INTERFACE ERRORS (cumulative) ────────────
  header "INTERFACE ERRORS (cumulative)"
  for iface in /sys/class/net/enp*; do
    [ -d "$iface" ] || continue
    local name
    name="$(basename "$iface")"
    local s
    s="$iface/statistics"
    printf "  %s: rx_err=%-6s rx_drop=%-6s tx_err=%-6s tx_drop=%-6s\n" \
      "$name" \
      "$(cat "$s/rx_errors" 2>/dev/null || echo N/A)" \
      "$(cat "$s/rx_dropped" 2>/dev/null || echo N/A)" \
      "$(cat "$s/tx_errors" 2>/dev/null || echo N/A)" \
      "$(cat "$s/tx_dropped" 2>/dev/null || echo N/A)"
  done

  # ── NAPI COALESCING ──────────────────────────
  header "NAPI INTERRUPT COALESCING"
  for iface in /sys/class/net/enp*; do
    [ -d "$iface" ] || continue
    local name
    name="$(basename "$iface")"
    local napi flush
    napi="$(cat "$iface/napi_defer_hard_irqs" 2>/dev/null || echo N/A)"
    flush="$(cat "$iface/gro_flush_timeout" 2>/dev/null || echo N/A)"
    if [ "$napi" = "0" ]; then
      metric_ok "$name napi_defer" "$napi  (correct)"
    else
      metric_warn "$name napi_defer" "$napi  (should be 0!)"
    fi
    metric_ok "$name gro_flush" "$flush"
  done

  # ── RP_FILTER ────────────────────────────────
  header "REVERSE PATH FILTER"
  for iface in /proc/sys/net/ipv4/conf/enp*/rp_filter; do
    [ -f "$iface" ] || continue
    local name val
    name="$(basename "$(dirname "$iface")")"
    val="$(cat "$iface")"
    if [ "$val" = "1" ] || [ "$val" = "0" ]; then
      metric_ok "$name rp_filter" "$val  (loose/off)"
    else
      metric_warn "$name rp_filter" "$val  (strict — drops packets on multi-homed!)"
    fi
  done

  # ── TCP RETRANSMISSIONS ──────────────────────
  header "TCP RETRANSMITS (since boot)"
  if [ -f /proc/net/snmp ]; then
    grep -E '^Tcp:' /proc/net/snmp | while read -r line; do
      echo "  $line"
    done
  fi

  # ── THROUGHPUT TEST (quick, per NIC) ─────────
  header "THROUGHPUT TEST (Cloudflare 25MB, per NIC)"
  for iface in enp2s0f0 enp5s0; do
    if [ "$(cat "/sys/class/net/$iface/operstate" 2>/dev/null)" != "up" ]; then
      echo "  $iface: DOWN — skipping"
      continue
    fi
    local speed time_spent
    speed="$(curl -s -o /dev/null -w '%{speed_download}' \
      --interface "$iface" --max-time 10 \
      'https://speed.cloudflare.com/__down?bytes=25000000' 2>/dev/null || echo 0)"
    if [ "$speed" = "0" ] || [ -z "$speed" ]; then
      metric_warn "$iface throughput" "FAILED"
    else
      local mbs
      mbs="$(echo "scale=1; $speed / 1048576" | bc 2>/dev/null || echo "$speed")"
      if [ "$(echo "$speed < 50000000" | bc 2>/dev/null)" = "1" ]; then
        metric_warn "$iface throughput" "${mbs} MB/s  (bajo!)"
      else
        metric_ok "$iface throughput" "${mbs} MB/s"
      fi
    fi
  done

  # ── LATENCY ──────────────────────────────────
  header "LATENCY (1.1.1.1, per NIC)"
  for iface in enp2s0f0 enp5s0; do
    if [ "$(cat "/sys/class/net/$iface/operstate" 2>/dev/null)" != "up" ]; then
      echo "  $iface: DOWN — skipping"
      continue
    fi
    local ping_out
    ping_out="$(ping -c 3 -W 2 -I "$iface" 1.1.1.1 2>&1 | tail -1 || true)"
    echo "  $iface: $ping_out"
  done

  # ── ETHTOOL (sudo) ────────────────────────────
  if needs_sudo; then
    header "ETHTOOL DRIVER INFO"
    for iface in enp2s0f0 enp5s0; do
      sudo ethtool -i "$iface" 2>/dev/null | grep -E 'driver|firmware|bus' | while read -r line; do
        echo "  $iface: $line"
      done
    done

    header "ETHTOOL STATISTICS (errors only)"
    for iface in enp2s0f0 enp5s0; do
      local et
      et="$(sudo ethtool -S "$iface" 2>/dev/null | grep -iE 'err|drop|discard|fail|crc' || true)"
      if [ -n "$et" ]; then
        echo "  $iface:"
        echo "$et" | while read -r line; do printf "    %s\n" "$line"; done
      fi
    done
  else
    echo ""
    echo "  ⚠ sudo not available — skipping ethtool stats."
    echo "  Run with: sudo netdiag"
  fi

  # ── DNS ──────────────────────────────────────
  header "DNS RESOLUTION"
  if command -v resolvectl &>/dev/null; then
    resolvectl status 2>/dev/null | head -10
  else
    cat /etc/resolv.conf 2>/dev/null | grep -v '^#' | grep -v '^$'
  fi

  # ── NM CONNECTIONS ───────────────────────────
  header "NETWORKMANAGER ACTIVE CONNECTIONS"
  if command -v nmcli &>/dev/null; then
    nmcli -t -f DEVICE,TYPE,STATE,IP4.ADDRESS device status 2>/dev/null | grep -v '^$'
  fi

  echo ""
  echo "══════════════════════════════════════════════"
  echo "  DIAGNOSTIC COMPLETE — $ts"
  echo "══════════════════════════════════════════════"
}

# ── WATCH MODE ──────────────────────────────────
if [ "$WATCH_INTERVAL" -gt 0 ] 2>/dev/null; then
  echo "⏱  netdiag — watch mode (interval=${WATCH_INTERVAL}s)"
  echo "   Press Ctrl+C to stop."
  echo ""

  # Baseline: run once and store RX bytes
  declare -A prev_rx_bytes
  for iface in /sys/class/net/enp*/statistics/rx_bytes; do
    [ -f "$iface" ] || continue
    name="$(basename "$(dirname "$(dirname "$iface")")")"
    prev_rx_bytes["$name"]="$(cat "$iface")"
  done

  prev_time="$(date +%s)"

  while true; do
    sleep "$WATCH_INTERVAL"

    local now degradation=0
    now="$(date +%s)"
    local elapsed=$(( now - prev_time ))
    [ "$elapsed" -lt 1 ] && elapsed=1

    for iface in /sys/class/net/enp*/statistics/rx_bytes; do
      [ -f "$iface" ] || continue
      name="$(basename "$(dirname "$(dirname "$iface")")")"
      local curr_bytes
      curr_bytes="$(cat "$iface")"
      local prev="${prev_rx_bytes[$name]:-0}"
      local diff=$(( curr_bytes - prev ))
      local rate=$(( diff / elapsed ))

      # Flag if rate drops below 1 MB/s while interface is up
      local operstate
      operstate="$(cat "/sys/class/net/$name/operstate" 2>/dev/null)"
      if [ "$operstate" = "up" ] && [ "$rate" -lt 1048576 ]; then
        degradation=1
      fi

      prev_rx_bytes["$name"]="$curr_bytes"
    done

    if [ "$degradation" -eq 1 ]; then
      capture_snapshot
      degradation=0
    fi

    prev_time="$now"
  done
else
  capture_snapshot
fi
