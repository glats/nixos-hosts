#!/usr/bin/env bash
# opencode-home — scoped proxy launcher for OpenCode on mact2.
#
# Part of the mact2↔rog private-link stack
# (darwin/system/sing-box-link.nix); to point OTHER apps at the same
# loopback proxy, see docs/home-link.md (per-app proxy table).
#
# Exports HTTPS_PROXY/HTTP_PROXY pointing at the sing-box loopback
# mixed inbound (127.0.0.1:2080, darwin/system/sing-box-link.nix)
# ONLY while that inbound is listening, then execs opencode with all
# arguments. Scoped proxy env — MCP children are scrubbed via
# mcp.environment in the generated opencode.json
# (shared/opencode/runtime-config.nix). Never export these variables in
# shell profiles — this launcher is the ONLY path that sets them.
#
# Graceful both ways: with the link down, opencode runs WITHOUT proxy
# vars (normal corporate path) after a stderr notice; with the link
# up, OpenAI traffic rides the link (outer SNI tun.glats.org only).
#
# Runtime proof (2026-08-28): `curl -x http://127.0.0.1:2080
# https://auth.openai.com` presents the real origin cert (Google Trust
# Services WE1), and the rog sing-box log shows [mact2] →
# auth.openai.com:443 — the loopback CONNECT carries no SNI for the
# agent's category routing to act on.

set -euo pipefail

# Loopback mixed inbound (sing-box "mixed-in" tag).
LINK_HOST="127.0.0.1"
LINK_PORT="2080"

# Probe before exporting: -z = connect-only scan, -w 1 = 1s cap so a
# wedged listener cannot stall the launch. BSD nc (macOS) supports both.
if nc -z -w 1 "$LINK_HOST" "$LINK_PORT" >/dev/null 2>&1; then
  export HTTPS_PROXY="http://${LINK_HOST}:${LINK_PORT}"
  export HTTP_PROXY="http://${LINK_HOST}:${LINK_PORT}"
else
  echo "opencode-home: ${LINK_HOST}:${LINK_PORT} not listening — launching opencode WITHOUT proxy env" >&2
fi

exec opencode "$@"
