#!/usr/bin/env bash
# ai-backup - One-shot compressed backup/restore of AI assistant state.
#
# Backs up Claude Code, OpenCode and Engram data from a source host
# (default: mact2) into rog's samba share as a single .tar.zst archive:
#
#   ~/.claude                      (conversations, history, skills, settings)
#   ~/.config/opencode             (config, skills, plugins; no node_modules)
#   ~/.local/share/opencode        (auth.json, storage, snapshot, delegations)
#   ~/.engram                      (global engram DB)
#
# Live SQLite databases (opencode *.db, engram.db) are snapshotted with
# `sqlite3 .backup` first — consistent even with WAL — and stored inside the
# archive under home-snap/, which restore relocates to their live paths.
#
# Usage:
#   ai-backup [TARGET]              backup TARGET (default mact2) -> rog
#   ai-backup list                  list archives in the destination
#   ai-backup restore ARCHIVE [--to TARGET] [--dry-run]
#                                   restore archive into TARGET ($HOME)
#
# TARGET: local | mact2 | t14 | thinkcentre | user@host
#
# Environment overrides:
#   AI_BACKUP_DEST        destination root (default samba share on rog)
#   AI_BACKUP_ZSTD_LEVEL  zstd level, 1-19 (default 6)
#   AI_BACKUP_SSH_OPTS    extra ssh options
#
# Exit codes:
#   0 success  1 usage/config  2 ssh/connectivity  3 snapshot/backup failure
#   4 restore failure

set -euo pipefail

DEST="${AI_BACKUP_DEST:-/run/media/stuff/samba/backup/ai}"
ZSTD_LEVEL="${AI_BACKUP_ZSTD_LEVEL:-6}"
SSH_OPTS="${AI_BACKUP_SSH_OPTS:--o BatchMode=yes -o ConnectTimeout=8}"

usage() {
  awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
  exit "${1:-0}"
}

# --- Target resolution -------------------------------------------------------
resolve_target() {
  case "$1" in
    local) echo "local" ;;
    mact2) echo "jcuzmar@mact2.local" ;;
    t14) echo "glats@t14.local" ;;
    thinkcentre) echo "glats@thinkcentre.local" ;;
    *) echo "$1" ;; # user@host passthrough
  esac
}

target_label() { # short filesystem-safe name for archive naming
  case "$1" in
    local) hostname ;;
    *@*) echo "${1%%@*}-${1#*@}" | tr './' '--' ;;
    *) echo "$1" ;;
  esac
}

# --- Remote payload (POSIX sh, runs on the source host) ----------------------
# Emits a tar stream on stdout: the four state trees (DBs excluded) plus
# home-snap/ holding consistent sqlite snapshots at their live relative paths.
remote_backup_script() {
  cat <<'REMOTE'
set -eu
HOME_DIR="$(cd ~ && pwd)"
SQLITE="$(command -v sqlite3 || echo /usr/bin/sqlite3)"
STAGING="$(mktemp -d "${TMPDIR:-/tmp}/ai-backup.XXXXXX")"
trap 'rm -rf "$STAGING"' EXIT INT TERM
mkdir -p "$STAGING/home-snap/.local/share/opencode" "$STAGING/home-snap/.engram"

snap() { # $1=live db path  $2=relative dest under home-snap/
  [ -f "$1" ] || return 0
  real="$(readlink -f "$1")"
  "$SQLITE" "$1" ".backup '$STAGING/home-snap/$2/$(basename "$real")'" || {
    echo "ai-backup: sqlite snapshot FAILED: $1" >&2
    exit 3
  }
}

for db in "$HOME_DIR"/.local/share/opencode/*.db; do
  [ -e "$db" ] || continue
  real="$(readlink -f "$db")"
  snap "$db" ".local/share/opencode"
done
snap "$HOME_DIR/.engram/engram.db" ".engram"

# Bail out before shipping if any snapshot is empty/corrupt.
for s in "$STAGING"/home-snap/.local/share/opencode/*.db "$STAGING"/home-snap/.engram/*.db; do
  [ -e "$s" ] || continue
  [ -s "$s" ] || { echo "ai-backup: empty snapshot: $s" >&2; exit 3; }
done

# NOTE: do not `exec` — the EXIT trap must survive to clean STAGING.
tar -cf - \
  --exclude='node_modules' \
  --exclude='.local/share/opencode/bin' \
  --exclude='.local/share/opencode/log' \
  --exclude='.local/share/opencode/logs' \
  --exclude='.local/share/opencode/*.db' \
  --exclude='.local/share/opencode/*.db-wal' \
  --exclude='.local/share/opencode/*.db-shm' \
  --exclude='.local/share/opencode/*.backup' \
  --exclude='.local/share/opencode/*.backup-*' \
  --exclude='.engram/engram.db' \
  --exclude='.engram/engram.db-wal' \
  --exclude='.engram/engram.db-shm' \
  --exclude='.engram/engram.db.*' \
  --exclude='.claude/cache' \
  -C "$HOME_DIR" .claude .config/opencode .local/share/opencode .engram \
  -C "$STAGING" home-snap
REMOTE
}

# Remote side of restore: relocate home-snap DBs to live paths, keep a
# pre-restore copy of any DB being replaced, then integrity-check.
remote_restore_script() {
  cat <<'REMOTE'
set -eu
SQLITE="$(command -v sqlite3 || echo /usr/bin/sqlite3)"
SNAP="$HOME/home-snap"
stamp="$(date +%Y%m%d-%H%M%S)"
place() { # $1=snapshot file  $2=live destination
  if [ -f "$2" ]; then
    echo "  replacing $(basename "$2") (old kept as $(basename "$2").pre-restore-$stamp)"
    mv "$2" "$2.pre-restore-$stamp"
  fi
  mkdir -p "$(dirname "$2")"
  mv "$1" "$2"
}
if [ -d "$SNAP" ]; then
  for f in "$SNAP"/.local/share/opencode/*.db; do
    [ -e "$f" ] || continue
    place "$f" "$HOME/.local/share/opencode/$(basename "$f")"
  done
  [ -f "$SNAP/.engram/engram.db" ] && place "$SNAP/.engram/engram.db" "$HOME/.engram/engram.db"
  rm -rf "$SNAP"
fi
echo "  integrity check:"
rc=0
for db in "$HOME"/.local/share/opencode/*.db "$HOME"/.engram/engram.db; do
  [ -f "$db" ] || continue
  out="$("$SQLITE" "$db" 'PRAGMA integrity_check;' 2>&1 | head -1)" || rc=1
  echo "    $(basename "$db"): $out"
done
exit $rc
REMOTE
}

# --- Run a POSIX sh snippet on a target (local or over ssh) ------------------
run_on() { # $1=target, rest=argv for the snippet via stdin
  local target="$1"; shift
  if [ "$target" = "local" ]; then
    /bin/sh -s "$@"
  else
    ssh $SSH_OPTS "$target" /bin/sh -s "$@"
  fi
}

# --- Subcommand: backup ------------------------------------------------------
do_backup() {
  local target
  target="$(resolve_target "${1:-mact2}")"
  local label
  label="$(target_label "${1:-mact2}")"

  if [ "$target" != "local" ]; then
    echo "ai-backup: checking $target ..."
    ssh $SSH_OPTS "$target" 'command -v sqlite3 >/dev/null || echo "WARN: sqlite3 not in PATH, will use /usr/bin/sqlite3"' \
      || { echo "ERROR: cannot reach $target" >&2; exit 2; }
  fi

  local out_dir="$DEST/$label"
  mkdir -p "$out_dir"
  local ts archive part
  ts="$(date +%Y%m%d-%H%M%S)"
  archive="$out_dir/ai-backup-$label-$ts.tar.zst"
  part="$archive.part"

  echo "ai-backup: $target -> $archive"
  echo "           snapshotting sqlite, tarring, compressing (zstd -$ZSTD_LEVEL) ..."
  local t0 t1
  t0=$(date +%s)
  if ! run_on "$target" < <(remote_backup_script) | zstd "-T0" "-$ZSTD_LEVEL" > "$part"; then
    rm -f "$part"
    echo "ERROR: backup stream failed; partial file removed." >&2
    exit 3
  fi
  t1=$(date +%s)

  mv "$part" "$archive"
  ( cd "$out_dir" && sha256sum "$(basename "$archive")" > "$(basename "$archive").sha256" )
  local size
  size=$(du -h "$archive" | cut -f1)
  echo "ai-backup: done in $((t1 - t0))s — $size  $(basename "$archive")"
  echo "           sha256 recorded in $(basename "$archive").sha256"
}

# --- Subcommand: list --------------------------------------------------------
do_list() {
  if [ ! -d "$DEST" ]; then
    echo "ai-backup: no destination yet at $DEST"
    return 0
  fi
  local found=0
  while IFS= read -r -d '' archive; do
    found=1
    local size
    size=$(du -h "$archive" | cut -f1)
    printf '%s  %s\n' "$size" "${archive#$DEST/}"
  done < <(find "$DEST" -name 'ai-backup-*.tar.zst' -print0 | sort -z -r)
  [ "$found" -eq 1 ] || echo "ai-backup: no archives yet at $DEST"
}

# --- Subcommand: restore -----------------------------------------------------
do_restore() {
  local archive="" to="local" dry=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$2"; shift 2 ;;
      --to=*) to="${1#*=}"; shift ;;
      --dry-run) dry=1; shift ;;
      -h|--help) usage 0 ;;
      *) archive="$1"; shift ;;
    esac
  done
  [ -n "$archive" ] || usage 1
  [ -f "$archive" ] || { echo "ERROR: archive not found: $archive" >&2; exit 1; }
  if [ -f "$archive.sha256" ]; then
    echo "ai-backup: verifying sha256 ..."
    ( cd "$(dirname "$archive")" && sha256sum -c "$(basename "$archive").sha256" ) \
      || { echo "ERROR: sha256 mismatch" >&2; exit 4; }
  fi

  local target
  target="$(resolve_target "$to")"

  if [ -n "$dry" ]; then
    echo "ai-backup: DRY RUN — members of $(basename "$archive"):"
    zstd -dc "$archive" | tar -tf - | sed 's|^|  |' | head -60
    echo "  ... (full list: zstd -dc ARCHIVE | tar -tf -)"
    return 0
  fi

  echo "ai-backup: restoring $(basename "$archive") -> $target:\$HOME"
  echo "           (close opencode/claude on the target first)"
  local rc=0
  if [ "$target" = "local" ]; then
    zstd -dc "$archive" | tar -xf - -C "$HOME" || rc=1
    if [ $rc -eq 0 ]; then
      /bin/sh -s < <(remote_restore_script) || rc=1
    fi
  else
    zstd -dc "$archive" | ssh $SSH_OPTS "$target" "tar -xf - -C \$HOME" || rc=1
    if [ $rc -eq 0 ]; then
      ssh $SSH_OPTS "$target" /bin/sh -s < <(remote_restore_script) || rc=1
    fi
  fi
  [ $rc -eq 0 ] && echo "ai-backup: restore complete."
  return $rc
}

# --- Main --------------------------------------------------------------------
# No subcommand or a bare TARGET means: run a backup (default target mact2).
case "${1:-}" in
  "") do_backup mact2 ;;
  backup) shift; do_backup "${1:-mact2}" ;;
  list) do_list ;;
  restore) shift; do_restore "$@" ;;
  -h|--help|help) usage 0 ;;
  *) do_backup "$1" ;;
esac
