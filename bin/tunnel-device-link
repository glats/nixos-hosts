#!/usr/bin/env bash
# tunnel-device-link — runtime-only phone link printer for the OpenCode tunnel
#
# Reads the rendered phone UUID from the host's runtime secret path and
# prints a vless:// share link to stdout. NEVER writes the UUID or the
# link to the repo, Nix store, logs, or any file. Designed to be piped
# straight into a QR encoder or copied to a clipboard — do not redirect
# to disk, do not echo in CI, do not include in transcripts.
#
# Usage:
#   bin/tunnel-device-link phone            # prints link for phone device
#   bin/tunnel-device-link phone --config   # full sing-box config JSON for SFA
#   bin/tunnel-device-link phone /custom/uuid/path   # explicit UUID path
#
# Output modes:
#   default     vless:// share link (+ terminal QR when interactive).
#               Works for v2rayNG / NekoBox / Hiddify class clients.
#               NOTE: sing-box for Android (SFA) does NOT parse vless://
#               links (verified against SFA source — no share-link parser).
#   --config    Full sing-box client config JSON for SFA. Import as a
#               LOCAL profile via clipboard. The JSON embeds the UUID —
#               treat it like the password it is: paste it straight into
#               SFA, never store or share it.
#
# The WS path is the same obscuity-not-secret constant used by the rog
# server (linux/system/services/network/sing-box-tunnel.nix), nginx
# vhost (linux/system/services/web/nginx.nix), and mact2 client
# (darwin/system/sing-box-tunnel.nix). All four sites must stay
# byte-identical.
#
# Spec: Runtime-Only Android Link Delivery — never persisted anywhere.

set -euo pipefail

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") <device> [<uuid-file>]

Print a vless:// share link to stdout for importing into sing-box for
Android (SFA). The phone UUID is read at runtime from the host's
rendered sops file and never written to disk, the Nix store, or logs.

Arguments:
  <device>      Device name (cosmetic, used in the link fragment only).
  <uuid-file>   Optional explicit path to the rendered UUID file.
                Defaults:
                  - rog:     /run/secrets/opencode-tunnel/uuid_phone
                  - mact2:   /run/secrets/opencode-tunnel/uuid_phone

Environment:
  TUNNEL_PHONE_UUID_FILE  Override the UUID file path (CI / scripting).
EOF
  exit "${1:-0}"
}

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  usage 0
fi

device="$1"
shift

mode="link"
if [ "${1:-}" = "--config" ]; then
  mode="config"
  shift
fi

# Validate device name — used in the URL fragment so keep it tame.
if ! [[ "$device" =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo "error: device name '$device' must be [A-Za-z0-9_-]+" >&2
  exit 2
fi

# WS path constant — must match rog server, nginx vhost, mact2 client.
ws_path="/ed59280aa562f4b7eba4519e3c316e24"

# Resolve the UUID file path. Priority:
#   1. explicit positional argument
#   2. TUNNEL_PHONE_UUID_FILE env var
#   3. default path (rog + mact2 layout is identical)
uuid_file="${1:-${TUNNEL_PHONE_UUID_FILE:-/run/secrets/opencode-tunnel/uuid_phone}}"

if [ ! -r "$uuid_file" ]; then
  echo "error: UUID file not readable: $uuid_file" >&2
  echo "       (sops-install-secrets must have run; check activation log)" >&2
  exit 1
fi

# Read the UUID, strip trailing whitespace/newlines. Use cat | read so
# we don't accidentally leak the UUID into this process's argv (visible
# via /proc/<pid>/cmdline on Linux).
uuid="$(cat "$uuid_file")"
uuid="${uuid//[[:space:]]/}"

# Validate it looks like a UUID. Fail closed — a corrupt file MUST NOT
# produce a usable link.
if ! [[ "$uuid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
  echo "error: UUID at $uuid_file does not match UUID format" >&2
  exit 1
fi

# Print the share link. Fragment becomes the profile name in SFA.
# params (verified against the sing-box vless parser per addendum R5):
#   encryption=none  — VLESS without inner encryption
#   security=tls     — outer TLS, terminated by nginx
#   sni=tun.glats.org, fp=chrome — outer ClientHello matches mact2's
#                                  uTLS chrome fingerprint
#   type=ws, host=tun.glats.org, path=<ws> — WS transport over :443
# Interactive terminals also get a scannable QR (rendered to stdout,
# never a file — same runtime-only rule as the link). Piped stdout
# stays machine-consumable: URL only, no QR.
if [ "$mode" = "config" ]; then
  # Full sing-box client config for SFA (Local profile via clipboard).
  # Mirrors the mact2 darwin client minus macOS-specific bits (no
  # process rules on Android; Netskope CIDR exclusion is a Mac concern).
  # Validated shape: identical rule/dns/urltest structure passes
  # `sing-box check` on 1.13.x.
  printf '%s\n' "{
  \"log\": { \"level\": \"info\" },
  \"dns\": { \"servers\": [{ \"tag\": \"direct-dns\", \"type\": \"udp\", \"server\": \"1.1.1.1\" }] },
  \"inbounds\": [{
    \"type\": \"tun\", \"tag\": \"sb-tun\",
    \"address\": [\"172.19.0.1/30\"],
    \"auto_route\": true, \"strict_route\": true, \"stack\": \"system\"
  }],
  \"outbounds\": [
    {
      \"type\": \"vless\", \"tag\": \"tunnel-out\",
      \"server\": \"tun.glats.org\", \"server_port\": 443,
      \"uuid\": \"$uuid\",
      \"tls\": {
        \"enabled\": true, \"server_name\": \"tun.glats.org\",
        \"utls\": { \"enabled\": true, \"fingerprint\": \"chrome\" }
      },
      \"transport\": { \"type\": \"ws\", \"path\": \"$ws_path\", \"headers\": { \"Host\": \"tun.glats.org\" } }
    },
    { \"type\": \"direct\", \"tag\": \"direct\" },
    { \"type\": \"block\", \"tag\": \"block\" },
    {
      \"type\": \"urltest\", \"tag\": \"auto\",
      \"outbounds\": [\"tunnel-out\", \"direct\"],
      \"url\": \"https://www.gstatic.com/generate_204\",
      \"interval\": \"1m\", \"tolerance\": 50
    }
  ],
  \"route\": {
    \"rules\": [
      { \"action\": \"sniff\" },
      { \"protocol\": \"dns\", \"action\": \"hijack-dns\" },
      { \"network\": [\"icmp\"], \"outbound\": \"direct\" },
      { \"ip_is_private\": true, \"outbound\": \"direct\" }
    ],
    \"final\": \"auto\",
    \"auto_detect_interface\": true,
    \"default_domain_resolver\": \"direct-dns\"
  }
}"
  exit 0
fi

link="$(printf 'vless://%s@tun.glats.org:443?encryption=none&security=tls&sni=tun.glats.org&fp=chrome&type=ws&host=tun.glats.org&path=%s#mact2-tunnel-%s' \
  "$uuid" "$ws_path" "$device")"
printf '%s\n' "$link"

# Interactive terminals also get a scannable QR (rendered to stdout,
# never a file — same runtime-only rule as the link). Piped stdout
# stays machine-consumable: URL only, no QR.
if command -v qrencode >/dev/null 2>&1; then
  if [ -t 1 ]; then
    printf '\nScan in SFA (sing-box for Android → + → scan/import):\n\n' >&2
    qrencode -t ANSIUTF8 -m 2 "$link"
  fi
else
  printf '(qrencode not on PATH — copy the link and use SFA → + → Import from clipboard)\n' >&2
fi
