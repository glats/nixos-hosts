#!/usr/bin/env bash
set -euo pipefail

# ==== Constants ====
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
WORKTREES_DIR="${REPO_ROOT:+$REPO_ROOT/.worktrees}"
SCRIPT_NAME=$(basename "$0")

# ==== Helper Functions ====

die() {
  echo "Error: $1" >&2
  exit "${2:-1}"
}

usage() {
  local msg="${1:-}"
  if [[ -n "$msg" ]]; then
    echo "Error: $msg" >&2
    echo "" >&2
  fi
  cat >&2 <<EOF
Usage: $SCRIPT_NAME <worktree-name>    Create a named worktree
       $SCRIPT_NAME --finish           Finish current worktree and clean up
       $SCRIPT_NAME --list             List all worktrees
       $SCRIPT_NAME --prune            Prune stale worktree references
       $SCRIPT_NAME --help             Show this help message

Examples:
  $SCRIPT_NAME my-feature       Create worktree 'my-feature' from current branch
  $SCRIPT_NAME --finish         Finish current worktree (run from inside it)
  $SCRIPT_NAME --list           Show all active worktrees

The script works with git worktrees in .worktrees/ under the repository root.
When creating, it branches off the CURRENT branch (not hardcoded to main/master).
When finishing, it reads .worktree-base to return to the original branch.
EOF
  exit 2
}

get_current_branch() {
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || die "Failed to determine current branch"
  if [[ "$branch" == "HEAD" ]]; then
    die "Detached HEAD state. Checkout a branch before creating a worktree."
  fi
  echo "$branch"
}

is_in_worktree() {
  [[ -n "$REPO_ROOT" && "$PWD" == "$WORKTREES_DIR"* ]]
}

get_worktree_name() {
  basename "$PWD"
}

read_marker() {
  local wt_path="$1"
  local marker="$wt_path/.worktree-base"
  if [[ ! -f "$marker" ]]; then
    echo "" >&2
    echo "Error: No .worktree-base found in this worktree." >&2
    echo "" >&2
    echo "This worktree was created with an older version or manually." >&2
    echo "" >&2
    echo "To finish it manually:" >&2
    echo "  1. cd $REPO_ROOT" >&2
    echo "  2. git checkout <base-branch>" >&2
    echo "  3. git worktree remove $wt_path" >&2
    echo "  4. git branch -d $(basename "$wt_path")" >&2
    exit 1
  fi
  cat "$marker"
}

validate_name() {
  local name="$1"
  if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
    die "Invalid worktree name '$name'. Use alphanumeric, dots, hyphens, underscores. No slashes." 2
  fi
}

has_upstream() {
  local branch="$1"
  git rev-parse --abbrev-ref "$branch@{u}" &>/dev/null
}

check_gitignore() {
  local gitignore="$REPO_ROOT/.gitignore"
  if [[ -f "$gitignore" ]]; then
    if ! grep -qE '^\.(worktrees|worktrees/)' "$gitignore"; then
      echo "Warning: .worktrees/ not in .gitignore. Add it to prevent accidental commits." >&2
    fi
  fi
}

# ==== Command Functions ====

cmd_create() {
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    usage "Missing worktree name"
  fi

  if [[ -z "$REPO_ROOT" ]]; then
    die "Not inside a git repository"
  fi

  validate_name "$name"

  # Check worktree doesn't already exist
  if [[ -d "$WORKTREES_DIR/$name" ]]; then
    die "Worktree '$name' already exists at $WORKTREES_DIR/$name"
  fi

  # Capture current branch
  local current_branch
  current_branch=$(get_current_branch)

  # Check dirty state
  if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
    echo "Error: Current branch '$current_branch' has uncommitted changes." >&2
    echo "" >&2
    echo "Commit or stash before creating a worktree:" >&2
    echo "  git add -A && git commit -m 'message'" >&2
    echo "  # or: git stash" >&2
    exit 1
  fi

  # Check branch doesn't already exist
  if git show-ref --verify --quiet "refs/heads/$name"; then
    die "Branch '$name' already exists. Choose a different worktree name."
  fi

  # Create branch from current branch
  git branch "$name" "$current_branch"

  # Create worktree
  git worktree add "$WORKTREES_DIR/$name" "$name"

  # Write marker file
  echo "$current_branch" > "$WORKTREES_DIR/$name/.worktree-base"

  # Check .gitignore (non-fatal warning)
  check_gitignore

  # Success output
  echo "====================================="
  echo "> Created worktree: $name"
  echo "> Location: $WORKTREES_DIR/$name"
  echo "> Branch: $name (from $current_branch)"
  echo ""
  echo "To work in this worktree:"
  echo "  cd $WORKTREES_DIR/$name"
  echo "  opencode"
  echo ""
  echo "When done:"
  echo "  code-work --finish"
  echo "====================================="

  return 0
}

cmd_finish() {
  if [[ -z "$REPO_ROOT" ]]; then
    die "Not inside a git repository"
  fi

  if ! is_in_worktree; then
    die "Not inside a worktree directory (current: $PWD, worktrees: $WORKTREES_DIR)"
  fi

  local wt_name
  wt_name=$(get_worktree_name)
  local wt_path="$PWD"

  # Check marker file
  local base_branch
  base_branch=$(read_marker "$wt_path")

  # Check dirty state
  if [[ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]]; then
    echo "Error: uncommitted changes in worktree '$wt_name'." >&2
    echo "" >&2
    echo "Commit before finishing:" >&2
    echo "  git add -A && git commit -m 'message'" >&2
    exit 1
  fi

  # Check upstream before deletion
  local current_branch
  current_branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD)
  if ! has_upstream "$current_branch"; then
    echo "Error: Branch '$current_branch' has not been pushed to upstream." >&2
    echo "Local commits would be lost on deletion." >&2
    echo "" >&2
    echo "To save your work before cleaning up:" >&2
    echo "  git push -u origin $current_branch" >&2
    echo "" >&2
    echo "Then run 'code-work --finish' again." >&2
    echo "" >&2
    echo "To force cleanup anyway:" >&2
    echo "  cd $REPO_ROOT" >&2
    echo "  git branch -D $current_branch" >&2
    echo "  git worktree remove $wt_path" >&2
    echo "  git worktree prune" >&2
    exit 1
  fi

  # === Cleanup ===
  cd "$REPO_ROOT"

  # Checkout base branch
  echo "> Returning to base branch '$base_branch'..."
  if ! git checkout "$base_branch"; then
    die "Failed to checkout base branch '$base_branch'. It may have been deleted."
  fi

  # Remove worktree
  echo "> Removing worktree '$wt_name'..."
  if ! git worktree remove "$wt_path" --force; then
    die "Failed to remove worktree at $wt_path"
  fi

  # Delete branch (safe — upstream exists since we checked)
  echo "> Deleting branch '$current_branch'..."
  git branch -D "$current_branch"

  # Prune stale refs
  echo "> Pruning stale worktree references..."
  git worktree prune

  echo ""
  echo "====================================="
  echo "> Worktree '$wt_name' finished and cleaned up."
  echo "> Returned to branch '$base_branch'."
  echo "====================================="

  return 0
}

cmd_list() {
  if [[ -z "$REPO_ROOT" ]]; then
    die "Not inside a git repository"
  fi

  git -C "$REPO_ROOT" worktree list

  # Indicate current worktree if applicable
  if is_in_worktree; then
    echo ""
    echo "  (current worktree: $(get_worktree_name))"
  fi
}

cmd_prune() {
  if [[ -z "$REPO_ROOT" ]]; then
    die "Not inside a git repository"
  fi

  git -C "$REPO_ROOT" worktree prune
  echo "> Stale worktree references pruned."
}

# ==== Main Dispatch ====
case "${1:-}" in
  --finish|finish)  shift; cmd_finish "$@" ;;
  --list|list)      cmd_list ;;
  --prune|prune)    cmd_prune ;;
  --help|-h)        usage ;;
  "")               usage "Missing worktree name" ;;
  *)                cmd_create "$1" ;;
esac
