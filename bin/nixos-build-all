#!/usr/bin/env bash
# nixos-build-all - Check/eval/build every host in this flake.

set -euo pipefail

REPO_ROOT="${NIXOS_REPO:-}"
if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT="$HOME/.config/nix"
fi

FLAKE_PATH="$REPO_ROOT"
COMMAND="${1:-check}"

NIXOS_HOSTS=()
DARWIN_HOSTS=()
HOME_HOSTS=()

run_build() {
  if command -v nom >/dev/null 2>&1; then
    "$@" |& nom
  else
    "$@"
  fi
}

load_hosts() {
  readarray -t NIXOS_HOSTS < <(nix eval --raw "$FLAKE_PATH#nixosConfigurations" --apply 'attrs: builtins.concatStringsSep "\n" (builtins.attrNames attrs)')
  readarray -t DARWIN_HOSTS < <(nix eval --raw "$FLAKE_PATH#darwinConfigurations" --apply 'attrs: builtins.concatStringsSep "\n" (builtins.attrNames attrs)')
  readarray -t HOME_HOSTS < <(nix eval --raw "$FLAKE_PATH#homeConfigurations" --apply 'attrs: builtins.concatStringsSep "\n" (builtins.attrNames attrs)')
}

usage() {
  cat <<'EOF'
Usage: nixos-build-all [command]

Commands:
  check   Validate the whole flake without building (default)
  eval    Evaluate every NixOS, Darwin, and Home Manager host output
  build   Build every system host output with --no-link
  hm      Build every standalone Home Manager activation package with --no-link
  all     Run check, eval, build, and hm
EOF
}

check_all() {
  echo "> Checking flake (no build)..."
  nix flake check "$FLAKE_PATH" --no-build
}

eval_all() {
  local host

  load_hosts

  for host in "${NIXOS_HOSTS[@]}"; do
    echo "> Evaluating NixOS host: $host"
    nix eval --raw "$FLAKE_PATH#nixosConfigurations.$host.config.system.build.toplevel.drvPath" >/dev/null
  done

  for host in "${DARWIN_HOSTS[@]}"; do
    echo "> Evaluating Darwin host: $host"
    nix eval --raw "$FLAKE_PATH#darwinConfigurations.$host.config.system.build.toplevel.drvPath" >/dev/null
  done

  for host in "${HOME_HOSTS[@]}"; do
    echo "> Evaluating Home Manager host: $host"
    nix eval --raw "$FLAKE_PATH#homeConfigurations.$host.activationPackage.drvPath" >/dev/null
  done
}

build_systems() {
  local host

  load_hosts

  for host in "${NIXOS_HOSTS[@]}"; do
    echo "> Building NixOS host: $host"
    run_build nix build "$FLAKE_PATH#nixosConfigurations.$host.config.system.build.toplevel" --no-link
  done

  for host in "${DARWIN_HOSTS[@]}"; do
    echo "> Building Darwin host: $host"
    run_build nix build "$FLAKE_PATH#darwinConfigurations.$host.config.system.build.toplevel" --no-link
  done
}

build_hm() {
  local host

  load_hosts

  for host in "${HOME_HOSTS[@]}"; do
    echo "> Building Home Manager host: $host"
    run_build nix build "$FLAKE_PATH#homeConfigurations.$host.activationPackage" --no-link
  done
}

case "$COMMAND" in
  check) check_all ;;
  eval) eval_all ;;
  build) build_systems ;;
  hm) build_hm ;;
  all)
    check_all
    eval_all
    build_systems
    build_hm
    ;;
  help|-h|--help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
