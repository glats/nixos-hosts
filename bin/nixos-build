#!/usr/bin/env bash
# nixos-build - Helper to build NixOS configuration from main repo or worktree
# Auto-detects if in worktree and uses correct flake path
# Auto-detects hostname for multi-host configuration
# Auto-detects nh (default) vs nixos-rebuild (--raw) as the build driver
# Auto-detects nix-output-monitor (nom) for better build output (--raw only)

set -euo pipefail

# Detect repo root: env var > git detection from CWD > conventional fallback
REPO_ROOT="${NIXOS_REPO:-}"
if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT="$HOME/.nixos"
fi

# Detect if we're in a worktree
get_flake_path() {
  local current_dir="$PWD"

  # Check if we're in a worktree
  if [[ "$current_dir" == "$REPO_ROOT/.worktrees"* ]]; then
    # In worktree - use current directory
    echo "."
  elif [[ "$current_dir" == "$REPO_ROOT"* ]]; then
    # In main repo
    echo "/etc/nixos"
  else
    # Outside repo - assume main repo
    echo "/etc/nixos"
  fi
}

FLAKE_PATH=$(get_flake_path)

# Detect hostname for multi-host configuration
HOSTNAME=$(hostname)

# Default build driver: `nh os` (if installed). `nh` auto-detects the
# flake via NH_FLAKE (set by `programs.nh.flake` in modules/base/nh.nix)
# and the hostname, so calls like `nh os switch` need no extra args.
# `--raw` forces the legacy `nixos-rebuild` path. If `nh` is not
# available, fall back to `nixos-rebuild` automatically.
USE_NH=true
if ! command -v nh &>/dev/null; then
  USE_NH=false
fi

# Auto-detect nix-output-monitor (nom) for the --raw fallback path.
# `nh` has nom integration built in (toggle with `nh ... --no-nom`),
# so the nom wrapper is only relevant for nixos-rebuild.
USE_NOM=false
if command -v nom &>/dev/null; then
  USE_NOM=true
fi

# Parse flags before command
USE_RAW=false
for arg in "$@"; do
  case "$arg" in
    --raw)
      USE_RAW=true
      USE_NH=false
      ;;
    --no-nom)
      USE_NOM=false
      ;;
  esac
done

# Filter out known flags from arguments
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --raw|--no-nom) ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]}"

# Parse command
COMMAND="${1:-switch}"

# Helper to run a command with nom piped in (raw mode only).
# When using `nh`, omit this wrapper — nh ships with its own nom
# integration, and double-piping breaks nh's progress display.
run_with_nom() {
  if [[ "$USE_NOM" == "true" ]]; then
    "$@" |& nom
  else
    "$@"
  fi
}

# Validate command
if [[ "$COMMAND" == "help" ]] || [[ "$COMMAND" == "-h" ]] || [[ "$COMMAND" == "--help" ]]; then
  cat <<'EOF'
Usage: nixos-build [command] [--raw] [--no-nom]

Commands:
  switch     Build and activate (default)
  boot       Build and activate on next boot
  test       Build and activate in test environment
  upgrade    Update flake inputs then rebuild
  dry        Dry-activate (show changes only)
  check      Validate flake
  build      Dry-build only
  safe       Sequential: check -> build -> dry -> switch (stops on failure)

Options:
  --raw      Use nixos-rebuild instead of nh (escape hatch for edge cases)
  --no-nom   Disable nix-output-monitor even if available (--raw only)

Auto-detects:
  - Hostname: selects correct nixosConfiguration
  - Worktree: uses current directory (else /etc/nixos)
  - nh: uses `nh os` by default (if installed); nh has built-in nom
  - nom: only used in --raw mode; `nh` integrates nom natively
EOF
  exit 0
fi

# Build-driver dispatch helpers. Branches on USE_NH so every command
# stays a one-liner with no duplicated logic.
nh_run() {
  if [[ "$USE_NH" == "true" ]]; then
    nh "$@"
  else
    sudo nixos-rebuild "${@}" --flake "$FLAKE_PATH#$HOSTNAME"
  fi
}

case "$COMMAND" in
  switch)
    echo ""
    echo "> Building NixOS configuration (switch)..."
    if [[ "$USE_NH" == "true" ]]; then
      echo "> Driver: nh os switch (flake locked via NH_FLAKE)"
    else
      echo "> Driver: nixos-rebuild switch (--raw)"
      echo "> Using flake: $FLAKE_PATH#$HOSTNAME"
    fi
    if [[ "$USE_NH" == "true" ]]; then
      nh os switch
    else
      run_with_nom sudo nixos-rebuild switch --flake "$FLAKE_PATH#$HOSTNAME"
    fi
    ;;
  boot)
    echo ""
    echo "> Building NixOS configuration (boot)..."
    if [[ "$USE_NH" == "true" ]]; then
      echo "> Driver: nh os boot (flake locked via NH_FLAKE)"
    else
      echo "> Driver: nixos-rebuild boot (--raw)"
      echo "> Using flake: $FLAKE_PATH#$HOSTNAME"
    fi
    if [[ "$USE_NH" == "true" ]]; then
      nh os boot
    else
      run_with_nom sudo nixos-rebuild boot --flake "$FLAKE_PATH#$HOSTNAME"
    fi
    ;;
  test)
    echo ""
    echo "> Building NixOS configuration (test)..."
    if [[ "$USE_NH" == "true" ]]; then
      echo "> Driver: nh os test (flake locked via NH_FLAKE)"
    else
      echo "> Driver: nixos-rebuild test (--raw)"
      echo "> Using flake: $FLAKE_PATH#$HOSTNAME"
    fi
    if [[ "$USE_NH" == "true" ]]; then
      nh os test
    else
      run_with_nom sudo nixos-rebuild test --flake "$FLAKE_PATH#$HOSTNAME"
    fi
    ;;
  upgrade)
    echo ""
    if [[ "$USE_NH" == "true" ]]; then
      echo "> Updating flake inputs and rebuilding (nh os switch --update)..."
      nh os switch --update
    else
      echo "> Updating flake inputs..."
      nix flake update
      echo ""
      echo "> Building NixOS configuration (upgrade)..."
      echo "> Using flake: $FLAKE_PATH#$HOSTNAME"
      run_with_nom sudo nixos-rebuild switch --flake "$FLAKE_PATH#$HOSTNAME"
    fi
    ;;
  dry)
    if [[ "$USE_NH" == "true" ]]; then
      echo "> Dry-activating (showing changes via nh)..."
      nh os switch --dry
    else
      echo "> Dry-activating (showing changes)..."
      echo "> Using flake: $FLAKE_PATH#$HOSTNAME"
      sudo nixos-rebuild dry-activate --flake "$FLAKE_PATH#$HOSTNAME"
    fi
    ;;
  check)
    echo "> Validating flake..."
    nix flake check
    ;;
  build)
    echo "> Dry-building..."
    if [[ "$USE_NH" == "true" ]]; then
      nh build "$FLAKE_PATH#nixosConfigurations.$HOSTNAME.config.system.build.toplevel"
    else
      run_with_nom nix build "$FLAKE_PATH#nixosConfigurations.$HOSTNAME.config.system.build.toplevel"
    fi
    ;;
  safe)
    echo ""
    echo "> Running safe build workflow..."
    echo ""

    echo "> [1/4] Checking flake..."
    if ! nix flake check; then
      echo ""
      echo "> ERROR: Flake check failed. Stopping."
      exit 1
    fi
    echo ""

    echo "> [2/4] Building..."
    if [[ "$USE_NH" == "true" ]]; then
      if ! nh build "$FLAKE_PATH#nixosConfigurations.$HOSTNAME.config.system.build.toplevel"; then
        echo ""
        echo "> ERROR: Build failed. Stopping."
        exit 1
      fi
    else
      if ! run_with_nom nix build "$FLAKE_PATH#nixosConfigurations.$HOSTNAME.config.system.build.toplevel"; then
        echo ""
        echo "> ERROR: Build failed. Stopping."
        exit 1
      fi
    fi
    echo ""

    echo "> [3/4] Dry-activating..."
    if [[ "$USE_NH" == "true" ]]; then
      if ! nh os switch --dry; then
        echo ""
        echo "> ERROR: Dry-activate failed. Stopping."
        exit 1
      fi
    else
      if ! sudo nixos-rebuild dry-activate --flake "$FLAKE_PATH#$HOSTNAME"; then
        echo ""
        echo "> ERROR: Dry-activate failed. Stopping."
        exit 1
      fi
    fi
    echo ""

    echo "> [4/4] Switching..."
    if [[ "$USE_NH" == "true" ]]; then
      if ! nh os switch; then
        echo ""
        echo "> ERROR: Switch failed. Stopping."
        exit 1
      fi
    else
      if ! run_with_nom sudo nixos-rebuild switch --flake "$FLAKE_PATH#$HOSTNAME"; then
        echo ""
        echo "> ERROR: Switch failed. Stopping."
        exit 1
      fi
    fi

    echo ""
    echo "> Safe build completed successfully!"
    ;;
  *)
    echo "Unknown command: $COMMAND"
    echo "Run 'nixos-build help' for usage"
    exit 1
    ;;
esac
