#!/usr/bin/env bash
# nixos-build - Helper to build NixOS or Darwin configuration
# Auto-detects platform (Linux vs Darwin), worktree, hostname, and tools (nh, nom)
#
# Usage:
#   nixos-build [command] [--raw] [--no-nom]
#
# Commands:
#   switch     Build and activate (default)
#   boot       Build and activate on next boot (NixOS only)
#   test       Build in test environment (NixOS only)
#   upgrade    Update npm packages + flake inputs + rebuild
#   dry        Dry-activate (show changes only)
#   check      Validate flake
#   build      Dry-build only
#   safe       Sequential: check -> build -> dry -> switch (stops on failure)

set -euo pipefail

# --- Platform detection ---
IS_DARWIN=false
if [[ "$(uname)" == "Darwin" ]]; then
  IS_DARWIN=true
fi

# --- Repo root ---
REPO_ROOT="${NIXOS_REPO:-}"
if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT="$HOME/.nixos"
fi

# --- Flake path (worktree-aware) ---
get_flake_path() {
  local current_dir="$PWD"
  if [[ "$current_dir" == "$REPO_ROOT/.worktrees"* ]]; then
    echo "."
  elif [[ "$current_dir" == "$REPO_ROOT"* ]]; then
    echo "$REPO_ROOT"
  else
    echo "$REPO_ROOT"
  fi
}

FLAKE_PATH=$(get_flake_path)
HOSTNAME=$(hostname)

# --- Tool detection (Linux only) ---
USE_NH=false
USE_NOM=false
if ! $IS_DARWIN; then
  if command -v nh &>/dev/null; then
    USE_NH=true
  fi
  if command -v nom &>/dev/null; then
    USE_NOM=true
  fi
fi

# --- Parse flags ---
USE_RAW=false
for arg in "$@"; do
  case "$arg" in
    --raw) USE_RAW=true; USE_NH=false ;;
    --no-nom) USE_NOM=false ;;
  esac
done

ARGS=()
for arg in "$@"; do
  case "$arg" in
    --raw|--no-nom) ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]}"

COMMAND="${1:-switch}"

# --- Helpers ---
run_with_nom() {
  if [[ "$USE_NOM" == "true" ]]; then
    "$@" |& nom
  else
    "$@"
  fi
}

update_npm_packages() {
  echo "> Updating npm packages to latest..."
  UPDATE_SCRIPT=$(nix build "$FLAKE_PATH#opencode-npm-packages.updateScript" --no-link --print-out-paths 2>/dev/null || true)
  if [[ -n "$UPDATE_SCRIPT" ]]; then
    "$UPDATE_SCRIPT"
  fi
}

darwin_build() {
  sudo darwin-rebuild "$@" --flake "$FLAKE_PATH#$HOSTNAME"
}

# --- Help ---
if [[ "$COMMAND" == "help" || "$COMMAND" == "-h" || "$COMMAND" == "--help" ]]; then
  echo "Usage: nixos-build [command] [--raw] [--no-nom]"
  echo ""
  echo "Commands:"
  echo "  switch     Build and activate (default)"
  echo "  boot       Build and activate on next boot (NixOS only)"
  echo "  test       Build and activate in test environment (NixOS only)"
  echo "  upgrade    Update npm packages + flake inputs + rebuild"
  echo "  dry        Dry-activate (show changes only)"
  echo "  check      Validate flake"
  echo "  build      Dry-build only"
  echo "  safe       Sequential: check -> build -> dry -> switch"
  echo ""
  echo "Options:"
  echo "  --raw      Use nixos-rebuild instead of nh (Linux only)"
  echo "  --no-nom   Disable nix-output-monitor"
  exit 0
fi

# --- Command dispatch ---
case "$COMMAND" in
  switch)
    echo ""
    if $IS_DARWIN; then
      echo "> Building Darwin configuration (switch)..."
      darwin_build switch
    else
      echo "> Building NixOS configuration (switch)..."
      if [[ "$USE_NH" == "true" ]]; then
        nh os switch
      else
        run_with_nom sudo nixos-rebuild switch --flake "$FLAKE_PATH#$HOSTNAME"
      fi
    fi
    ;;

  boot)
    if $IS_DARWIN; then
      echo "> 'boot' not supported on Darwin. Use 'switch' instead."
      exit 1
    fi
    echo ""
    echo "> Building NixOS configuration (boot)..."
    if [[ "$USE_NH" == "true" ]]; then
      nh os boot
    else
      run_with_nom sudo nixos-rebuild boot --flake "$FLAKE_PATH#$HOSTNAME"
    fi
    ;;

  test)
    if $IS_DARWIN; then
      echo "> 'test' not supported on Darwin. Use 'switch' instead."
      exit 1
    fi
    echo ""
    echo "> Building NixOS configuration (test)..."
    if [[ "$USE_NH" == "true" ]]; then
      nh os test
    else
      run_with_nom sudo nixos-rebuild test --flake "$FLAKE_PATH#$HOSTNAME"
    fi
    ;;

  upgrade)
    echo ""
    update_npm_packages
    echo ""
    if $IS_DARWIN; then
      echo "> Updating flake inputs..."
      nix flake update --flake "$FLAKE_PATH"
      echo ""
      echo "> Building Darwin configuration (upgrade)..."
      darwin_build switch
    else
      if [[ "$USE_NH" == "true" ]]; then
        echo "> Updating flake inputs and rebuilding (nh os switch --update)..."
        nh os switch --update
      else
        echo "> Updating flake inputs..."
        nix flake update
        echo ""
        echo "> Building NixOS configuration (upgrade)..."
        run_with_nom sudo nixos-rebuild switch --flake "$FLAKE_PATH#$HOSTNAME"
      fi
    fi
    ;;

  dry)
    echo ""
    if $IS_DARWIN; then
      echo "> Checking Darwin configuration (dry run)..."
      darwin_build check
    else
      if [[ "$USE_NH" == "true" ]]; then
        echo "> Dry-activating (nh)..."
        nh os switch --dry
      else
        echo "> Dry-activating..."
        sudo nixos-rebuild dry-activate --flake "$FLAKE_PATH#$HOSTNAME"
      fi
    fi
    ;;

  check)
    echo "> Validating flake..."
    nix flake check
    ;;

  build)
    echo "> Dry-building..."
    if $IS_DARWIN; then
      run_with_nom nix build "$FLAKE_PATH#darwinConfigurations.$HOSTNAME.config.system.build.toplevel"
    else
      if [[ "$USE_NH" == "true" ]]; then
        nh build "$FLAKE_PATH#nixosConfigurations.$HOSTNAME.config.system.build.toplevel"
      else
        run_with_nom nix build "$FLAKE_PATH#nixosConfigurations.$HOSTNAME.config.system.build.toplevel"
      fi
    fi
    ;;

  safe)
    echo ""
    echo "> Running safe build workflow..."
    echo ""

    echo "> [1/4] Checking flake..."
    if ! nix flake check; then
      echo ""
      echo "> ERROR: Flake check failed. Stopping."
      exit 1
    fi
    echo ""

    echo "> [2/4] Building..."
    if $IS_DARWIN; then
      if ! run_with_nom nix build "$FLAKE_PATH#darwinConfigurations.$HOSTNAME.config.system.build.toplevel"; then
        echo ""
        echo "> ERROR: Build failed. Stopping."
        exit 1
      fi
    else
      if [[ "$USE_NH" == "true" ]]; then
        if ! nh build "$FLAKE_PATH#nixosConfigurations.$HOSTNAME.config.system.build.toplevel"; then
          echo ""
          echo "> ERROR: Build failed. Stopping."
          exit 1
        fi
      else
        if ! run_with_nom nix build "$FLAKE_PATH#nixosConfigurations.$HOSTNAME.config.system.build.toplevel"; then
          echo ""
          echo "> ERROR: Build failed. Stopping."
          exit 1
        fi
      fi
    fi
    echo ""

    echo "> [3/4] Dry-activating..."
    if $IS_DARWIN; then
      if ! darwin_build check; then
        echo ""
        echo "> ERROR: Dry-activate failed. Stopping."
        exit 1
      fi
    else
      if [[ "$USE_NH" == "true" ]]; then
        if ! nh os switch --dry; then
          echo ""
          echo "> ERROR: Dry-activate failed. Stopping."
          exit 1
        fi
      else
        if ! sudo nixos-rebuild dry-activate --flake "$FLAKE_PATH#$HOSTNAME"; then
          echo ""
          echo "> ERROR: Dry-activate failed. Stopping."
          exit 1
        fi
      fi
    fi
    echo ""

    echo "> [4/4] Switching..."
    if $IS_DARWIN; then
      if ! darwin_build switch; then
        echo ""
        echo "> ERROR: Switch failed. Stopping."
        exit 1
      fi
    else
      if [[ "$USE_NH" == "true" ]]; then
        if ! nh os switch; then
          echo ""
          echo "> ERROR: Switch failed. Stopping."
          exit 1
        fi
      else
        if ! run_with_nom sudo nixos-rebuild switch --flake "$FLAKE_PATH#$HOSTNAME"; then
          echo ""
          echo "> ERROR: Switch failed. Stopping."
          exit 1
        fi
      fi
    fi

    echo ""
    echo "> Safe build completed successfully!"
    ;;

  *)
    echo "Unknown command: $COMMAND"
    echo "Run 'nixos-build help' for usage"
    exit 1
    ;;
esac
