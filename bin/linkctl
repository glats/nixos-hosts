#!/usr/bin/env bash
# linkctl — sysvinit-style control for the macOS link daemon.
#
# Part of the mact2↔rog private-link stack; see docs/home-link.md
# ("Start / stop / status of the link"). The daemon is a
# manual-operation wrapper: its plist sets RunAtLoad=false /
# KeepAlive=false (Apple TN2083 "run purely on demand"), so it never
# autostarts at boot and stays down if the process dies — the
# corporate path never depends on it. linkctl just makes the launchctl
# incantations memorable: start|stop|restart|status, systemctl-style.
#
# start/stop/restart mutate the system domain (root-only) and
# auto-promote via sudo re-exec; status works unprivileged.
# Post-reboot the job is
# auto-registered but idle (RunAtLoad=false → no pid): that is normal,
# `linkctl start` raises it.

set -euo pipefail

LABEL="org.nixos.sing-box"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"

usage() {
  echo "usage: linkctl start|stop|restart|status" >&2
  exit 1
}

# Print the state|pid lines plus a one-line hint for the two special
# states: bootout'ed / never loaded after reboot, and registered-but-
# idle post-reboot (state present, no pid).
print_state() {
  local out lines
  out="$(launchctl print "system/${LABEL}" 2>/dev/null || true)"
  if [[ -z "$out" ]]; then
    echo "linkctl: ${LABEL} stopped (booted out or never loaded since boot)"
    return 0
  fi
  lines="$(grep -E "state|pid" <<<"$out" || true)"
  if [[ -n "$lines" ]]; then
    echo "$lines"
  fi
  if ! grep -q "pid" <<<"$out"; then
    echo "linkctl: ${LABEL} registered, idle — run: linkctl start"
  fi
}

cmd_start() {
  if launchctl print "system/${LABEL}" >/dev/null 2>&1; then
    # Already loaded: kickstart starts it if stopped.
    launchctl kickstart "system/${LABEL}" 2>/dev/null \
      || echo "linkctl: kickstart failed for ${LABEL} (sudo?)" >&2
  elif launchctl bootstrap system "${PLIST}" 2>/dev/null; then
    launchctl kickstart "system/${LABEL}" 2>/dev/null \
      || echo "linkctl: kickstart failed for ${LABEL} (sudo?)" >&2
  else
    echo "linkctl: bootstrap failed for ${PLIST} (sudo?)" >&2
  fi
  print_state
}

cmd_stop() {
  local out rc
  out="$(launchctl bootout "system/${LABEL}" 2>&1)" && rc=0 || rc=$?
  if [[ $rc -eq 0 ]]; then
    echo "linkctl: ${LABEL} booted out — TUN down, 100% corporate path"
  elif [[ $rc -eq 3 ]] || grep -qiE "no such process|Could not find service" <<<"$out"; then
    echo "linkctl: ${LABEL} already stopped (nothing running — corporate path active)"
  else
    echo "linkctl: bootout failed (rc=${rc}): ${out}" >&2
  fi
}

cmd_restart() {
  # Stop-then-start (bootout → bootstrap+kickstart): simplest robust
  # path across loaded/unloaded states — avoids kickstart -k semantics
  # confusion. Bootout failure is fine here (may not be loaded).
  launchctl bootout "system/${LABEL}" 2>/dev/null || true
  if launchctl bootstrap system "${PLIST}" 2>/dev/null; then
    launchctl kickstart "system/${LABEL}" 2>/dev/null \
      || echo "linkctl: kickstart failed for ${LABEL} (sudo?)" >&2
  else
    echo "linkctl: bootstrap failed for ${PLIST} (sudo?)" >&2
  fi
  print_state
}

[[ $# -eq 1 ]] || usage

# Auto-promote: start/stop/restart mutate the SYSTEM domain (root-only).
# Re-exec with sudo using this script's resolved absolute path so it
# works from any directory and any PATH. `status` stays unprivileged.
if [[ $EUID -ne 0 && "$1" != "status" ]]; then
  self="$(command -v -- linkctl 2>/dev/null || true)"
  [[ -z "$self" || "$self" -ef "$0" ]] && self="$0"
  case "$self" in /*) ;; *) self="$PWD/${self#./}" ;; esac
  exec sudo "$self" "$@"
fi

case "$1" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  status) print_state ;;
  *) usage ;;
esac
