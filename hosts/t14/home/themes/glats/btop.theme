# Glats theme — btop theme
#
# Deployed to ~/.config/omarchy/themes/glats/btop.theme by
# hosts/t14/home/omarchy.nix. Activated by setting BTOP_THEME in
# btop's env or symlinking ~/.config/btop/themes/glats.theme to
# this file. Mirrors the 16-color palette.

theme[main_bg]="#1e1e2e"
theme[main_fg]="#cdd6f4"
theme[title]="#cdd6f4"
theme[hi_fg]="#89b4fa"
theme[selected_bg]="#45475a"
theme[selected_fg]="#cdd6f4"
theme[inactive_fg]="#585b70"
theme[graph_text]="#cdd6f4"
theme[proc_misc]="#cdd6f4"
theme[cpu_box]="#89b4fa"
theme[mem_box]="#a6e3a1"
theme[net_box]="#f5c2e7"
theme[proc_box]="#94e2d5"
theme[div_line]="#313244"
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"
theme[cpu_start]="#89b4fa"
theme[cpu_mid]="#f5c2e7"
theme[cpu_end]="#f38ba8"
theme[free_start]="#a6e3a1"
theme[free_mid]="#f9e2af"
theme[free_end]="#f38ba8"
theme[cached_start]="#94e2d5"
theme[cached_mid]="#f9e2af"
theme[cached_end]="#f38ba8"
theme[available_start]="#a6e3a1"
theme[available_mid]="#f9e2af"
theme[available_end]="#f38ba8"
theme[used_start]="#f5c2e7"
theme[used_mid]="#f9e2af"
theme[used_end]="#f38ba8"
theme[download_start]="#94e2d5"
theme[download_mid]="#f9e2af"
theme[download_end]="#f38ba8"
theme[upload_start]="#f5c2e7"
theme[upload_mid]="#f9e2af"
theme[upload_end]="#f38ba8"
