# Glats theme — btop theme
#
# Deployed to ~/.config/omarchy/themes/glats/btop.theme by
# hosts/t14/home/omarchy.nix. Activated by setting BTOP_THEME in
# btop's env or symlinking ~/.config/btop/themes/glats.theme to
# this file.
#
# Glats palette (monochrome, accent-only):
#   bg          #000000
#   fg          #dddddd
#   accent      #0d73cc
#   selection   #505050
#   dim         #8a8a8a

theme[main_bg]="#000000"
theme[main_fg]="#dddddd"
theme[title]="#dddddd"
theme[hi_fg]="#0d73cc"
theme[selected_bg]="#505050"
theme[selected_fg]="#dddddd"
theme[inactive_fg]="#8a8a8a"
theme[graph_text]="#dddddd"
theme[proc_misc]="#dddddd"
theme[cpu_box]="#0d73cc"
theme[mem_box]="#0d73cc"
theme[net_box]="#0d73cc"
theme[proc_box]="#0d73cc"
theme[div_line]="#505050"
theme[temp_start]="#dddddd"
theme[temp_mid]="#8a8a8a"
theme[temp_end]="#dddddd"
theme[cpu_start]="#0d73cc"
theme[cpu_mid]="#8a8a8a"
theme[cpu_end]="#dddddd"
theme[free_start]="#dddddd"
theme[free_mid]="#8a8a8a"
theme[free_end]="#dddddd"
theme[cached_start]="#0d73cc"
theme[cached_mid]="#8a8a8a"
theme[cached_end]="#dddddd"
theme[available_start]="#dddddd"
theme[available_mid]="#8a8a8a"
theme[available_end]="#dddddd"
theme[used_start]="#0d73cc"
theme[used_mid]="#8a8a8a"
theme[used_end]="#dddddd"
theme[download_start]="#0d73cc"
theme[download_mid]="#8a8a8a"
theme[download_end]="#dddddd"
theme[upload_start]="#0d73cc"
theme[upload_mid]="#8a8a8a"
theme[upload_end]="#dddddd"
