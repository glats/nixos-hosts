[remmina]
ssh_tunnel_privatekey=
name=mact2
password=.
enableaudio=0
precommand=
ssh_tunnel_enabled=0
labels=
ssh_tunnel_command=
keyboard_grab=0
viewonly=0
ignore-tls-errors=1
depth_profile=0
postcommand=
lossy_encoding=0
server=mact2.local
disablepasswordstoring=0
scale=0
gvncdebug=0
ssh_tunnel_command_args=
ssh_tunnel_username=
disconnect-prompt=0
disableclipboard=0
disableserverbell=0
ssh_tunnel_password=
enable-autostart=0
window_maximize=1
ssh_tunnel_server=
ssh_tunnel_loopback=0
group=
shared=0
notes_text=
viewmode=1
profile-lock=0
ssh_tunnel_certfile=
ssh_tunnel_auth=0
ssh_tunnel_passphrase=
username=jcuzmar
protocol=GVNC
