{
  config,
  lib,
  pkgs,
  ...
}:

with lib;

let
  # Reproduces `herdr integration install opencode` against a throwaway HOME
  # at build time, then copies the produced files out of it. The output layout
  # mirrors what the installer drops into ~/.config/opencode:
  #   plugins/herdr-agent-state.js  (OpenCode plugin auto-loaded from plugins/)
  #   herdr-tui-session.js          (shared TUI plugin)
  #   herdr-opencode/tui.js         (V2 directory entrypoint, registered in cli.json)
  herdrIntegration = pkgs.runCommand "herdr-opencode-integration" { } ''
    installHome=$(mktemp -d)
    mkdir -p "$installHome/.config/opencode"
    export XDG_CONFIG_HOME="$installHome/.config"
    export HOME="$installHome"
    ${pkgs.herdr}/bin/herdr integration install opencode

    mkdir -p "$out/plugins" "$out/herdr-opencode"
    cp "$installHome"/.config/opencode/plugins/herdr-agent-state.js "$out/plugins/"
    cp "$installHome"/.config/opencode/herdr-tui-session.js "$out/"
    cp "$installHome"/.config/opencode/herdr-opencode/tui.js "$out/herdr-opencode/"
  '';

  herdrConfig = pkgs.writeText "herdr-config.toml" ''
    # Managed by Home Manager. Declarative source: shared/herdr.nix.
    onboarding = false

    [worktrees]
    directory = "~/.herdr/worktrees"
  '';
in
{
  options.home.herdr = {
    enable = mkEnableOption "herdr agent multiplexer with git worktree workspaces" // {
      default = true;
    };

    integration = mkOption {
      type = types.package;
      readOnly = true;
      description = ''
        OpenCode plugin files generated by `herdr integration install opencode`
        at build time, laid out exactly as the installer writes them into
        ~/.config/opencode. Consumed by shared/opencode/runtime-config.nix.
      '';
    };
  };

  config = {
    home.herdr.integration = herdrIntegration;

    home.packages = mkIf config.home.herdr.enable [ pkgs.herdr ];

    home.file.".config/herdr/config.toml" = mkIf config.home.herdr.enable {
      force = true;
      source = herdrConfig;
    };

    # herdr rewrites config.toml (keybinding resets persist there), so follow
    # the opencode.json pattern: replace the read-only store link with a
    # mutable copy of the declarative content after every generation.
    home.activation.makeHerdrConfigMutable = mkIf config.home.herdr.enable (
      config.lib.dag.entryAfter [ "linkGeneration" ] ''
        herdr_config="${config.home.homeDirectory}/.config/herdr/config.toml"
        if [ -L "$herdr_config" ]; then
          src="$(${pkgs.coreutils}/bin/readlink -f "$herdr_config")"
          ${pkgs.coreutils}/bin/cp --remove-destination "$src" "$herdr_config"
        fi
        if [ -f "$herdr_config" ] && ! ${pkgs.diffutils}/bin/cmp -s "${herdrConfig}" "$herdr_config"; then
          ${pkgs.coreutils}/bin/cp --remove-destination "${herdrConfig}" "$herdr_config"
        fi
        if [ -f "$herdr_config" ]; then
          ${pkgs.coreutils}/bin/chmod 644 "$herdr_config"
        fi
      ''
    );
  };
}
