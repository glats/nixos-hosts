{
  "neutral": {
    "description": "Senior Architect mentor - helpful first, challenging when it matters",
    "mode": "primary",
    "prompt": "{file:./IDENTITY.md}\n\n{file:./SYSTEM_RULES.md}",
    "tools": {
      "bash": true,
      "read": true,
      "edit": true,
      "write": true,
      "delegate": true,
      "task": true,
      "delegation_list": true,
      "delegation_read": true,
      "mem_search": true,
      "mem_save": true,
      "mem_get_observation": true
    }
  },
  "toolOverlays": {
    "gentle-orchestrator": {
      "mem_search": true,
      "mem_save": true,
      "mem_get_observation": true,
      "delegation_list": true,
      "delegation_read": true
    },
    "subagent": {
      "mem_search": true,
      "mem_save": true,
      "mem_get_observation": true
    }
  },
  "permissionOverlays": {
    "gentle-orchestrator": {
      "task": {
        "*": "deny",
        "sdd-*": "allow"
      }
    }
  },
  "instructionOverlays": {
    "subagent": ["instructions/universal.md"],
    "gentle-orchestrator": ["instructions/universal.md", "instructions/orchestrator.md"]
  }
}
