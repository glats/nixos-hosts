{
  "neutral": {
    "description": "Senior Architect mentor - helpful first, challenging when it matters",
    "mode": "primary",
    "permission": {
      "task": {
        "*": "deny",
        "gentle-ai-*": "allow",
        "review-*": "allow",
        "jd-*": "allow"
      }
    }
  },
  "permissionOverlays": {
    "named": {
      "gentle-orchestrator": {
        "task": {
          "*": "deny",
          "gentle-ai-*": "allow",
          "review-*": "allow",
          "jd-*": "allow"
        }
      },
      "managed-writing-task": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "external_directory": {
          "/**": "deny"
        },
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "go test *": "allow",
          "go -C * test *": "allow"
        }
      }
    }
  },
  "instructionOverlays": {
    "gentle-orchestrator": [
      "../rules/authorization.md",
      "../rules/explore-mcp.md",
      "../rules/output-format.md"
    ],
    "gentle-ai-explore": [
      "../rules/authorization.md",
      "../rules/explore-mcp.md",
      "../rules/output-format.md"
    ],
    "subagent": [
      "../rules/authorization.md",
      "../rules/output-format.md"
    ]
  }
}
